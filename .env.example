# Copy to .env (git-ignored). Every key is optional: with none set, the pipeline runs in
# deterministic fallback mode (BM25 retrieval + extractive answers), no network needed.

# Any one key enables LLM mode. Order tried: openai → gemini → anthropic → openrouter.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# LLM_PROVIDER=openai          # force a provider first in the fallback chain
# LLM_TIER=small               # small (cheap, default) | best
# OPENAI_MODEL=gpt-5.4-mini    # per-provider model override (also GEMINI_MODEL, ANTHROPIC_MODEL, OPENROUTER_MODEL)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retries: exponential backoff with jitter, Retry-After honoured
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_BASE_S=0.5
# LLM_BACKOFF_MAX_S=8
# LLM_MIN_INTERVAL_S=0          # minimum spacing between LLM calls (client-side rate limit)

# RETRIEVAL_MODE=auto          # auto | lexical | hybrid
# DISABLE_LLM=1                # force deterministic mode even when keys are set
# USE_LOCAL_MODELS=1           # BERT QA + sentence-transformers + cross-encoder (pip install -r requirements-local-models.txt)
# MAX_CONCURRENCY=4            # concurrent questions in batch answering
# LLM_PRICES_JSON={"gpt-5.4-mini": [0.75, 4.5]}   # override cost estimates (USD per 1M tokens)
